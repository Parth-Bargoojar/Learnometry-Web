# --- SEO / deployment -------------------------------------------------------
# Canonical origin, no trailing slash. Drives canonical tags, sitemap.xml,
# robots.txt, OG image URLs, JSON-LD @id values and the www -> apex redirect.
# Change this ONE value when moving to a custom domain.
NEXT_PUBLIC_SITE_URL=https://learnometry-ai.vercel.app

# Google Search Console "HTML tag" verification token — the value of the
# content="..." attribute only, not the whole <meta> tag.
# Leave unset until you have it; the meta tag is then simply not rendered.
GOOGLE_SITE_VERIFICATION=

# --- Forms ------------------------------------------------------------------
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
